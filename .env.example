ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
PORT=3001

# Необязательно: ограничить, с какого домена можно дёргать API (в проде — URL сайта на Vercel)
ALLOWED_ORIGIN=
# Необязательно: лимиты предохранителя (значения по умолчанию: 15 / 120 / 400 / 4000)
AI_LIMIT_PER_MIN=
AI_LIMIT_PER_HOUR=
AI_LIMIT_PER_DAY=
AI_MAX_MESSAGE_CHARS=

# Пароль для входа на сайт
APP_PASSWORD=
WHOOP_REDIRECT_URI=

# PIN для кнопки «Сбросить все данные» (Settings → Connections). Живёт ТОЛЬКО здесь —
# не в коде фронтенда — иначе его видно в бандле любому. Без этой переменной кнопка
# сброса отвечает «не настроено» и ничего не делает.
RESET_PIN=
