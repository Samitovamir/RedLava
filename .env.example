# ─────────────────────────────────────────────────────────────────────────────
# Локально: скопировать в .env в КОРНЕ репозитория (backend/app.js читает именно его).
# На Vercel: те же имена задаются в настройках проекта, файла .env там нет.
# ─────────────────────────────────────────────────────────────────────────────

# ── Обязательное ─────────────────────────────────────────────────────────────

# Хранилище (Vercel KV / Upstash Redis). БЕЗ НЕГО НА ПРОДЕ НЕТ ПОСТОЯННЫХ ДАННЫХ:
# бэкенд — serverless-функция, и без внешнего хранилища он откатывается на память
# процесса, которая живёт до конца запроса. Аккаунты, токены интеграций и синхронизация
# будут пропадать. Локально можно не задавать — тогда используется файл backend/.localstore.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Синонимы, если хранилище подключено как Upstash напрямую (достаточно одной пары)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Секрет для подписи токенов входа. ОБЯЗАТЕЛЕН: без него подписывать нечем и вход
# отвечает 503. Отдельным случайным значением, не паролем человека — пароль
# низкоэнтропийен, и подпись HS256 на нём вскрывается офлайн-перебором.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Claude API — нужен ИИ-помощнику, разбору анализов и подбору блюд
ANTHROPIC_API_KEY=

# ── Вход ─────────────────────────────────────────────────────────────────────

# Пароль публичного демо-входа (логин: guest). По умолчанию '123'.
GUEST_PASSWORD=
# Код приглашения для регистрации. ЗАДАН — регистрация только по коду (нужно для клуба);
# ПУСТОЙ — зарегистрироваться может любой, кто открыл сайт.
REGISTRATION_CODE=

# Обычные аккаунты (username + пароль) лежат в хранилище, переменных окружения для них нет.
# Права администратора — флаг isAdmin в записи users:<id>, ставится вручную в хранилище.

# ── Интеграции ───────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# Куда возвращать браузер после OAuth. Не задан — берётся из заголовков запроса.
APP_URL=

# Картинки блюд (Unsplash) — необязательно, без ключа блюда просто без фото
UNSPLASH_ACCESS_KEY=

# Яндекс.Карты для вопросов «во сколько выезжать» — необязательно.
# Можно задать один YANDEX_MAPS_API_KEY либо раздельно геокодер и роутер.
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_ROUTER_KEY=

# ── Необязательные настройки ─────────────────────────────────────────────────

PORT=3001
# Ограничить домен, с которого можно дёргать API (в проде — URL сайта на Vercel).
# Пустой = кросс-доменные запросы закрыты (фронт и API на одном домене — им это не нужно).
ALLOWED_ORIGIN=

# Предохранители расхода на ИИ (по умолчанию: 60 / 300 / 1000 / 4000 символов)
AI_LIMIT_PER_MIN=
AI_LIMIT_PER_HOUR=
AI_LIMIT_PER_DAY=
AI_MAX_MESSAGE_CHARS=
# Дневной лимит запросов к ИИ на устройство для демо-гостей и новых аккаунтов (по умолчанию 15)
AI_GUEST_DAILY_LIMIT=
# Логировать расход токенов ИИ в консоль сервера
AI_DEBUG=
