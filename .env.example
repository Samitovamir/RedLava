# ─────────────────────────────────────────────────────────────────────────────
# Locally: copy this to .env in the REPOSITORY ROOT — that is the file
# backend/app.js loads, not backend/.env.
# On Vercel: the same names go in the project settings; there is no .env file there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Store (Vercel KV / Upstash Redis). WITHOUT IT PRODUCTION HAS NO PERSISTENT DATA:
# the backend is a serverless function, and with no external store it falls back to
# process memory, which lives only until the request ends. Accounts, integration
# tokens and sync state would all disappear between requests. Locally you can leave
# these empty — the file store at backend/.localstore.json is used instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Aliases, if the store is wired up as Upstash directly (either pair is enough)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to sign sign-in tokens. REQUIRED: without it there is nothing to sign
# with and auth answers 503. Use a separate random value, never someone's password —
# a password is low-entropy, and an HS256 signature made with one can be brute-forced
# offline from any issued token.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Claude API — needed by the assistant, the blood-test parsing and meal suggestions
ANTHROPIC_API_KEY=

# ── Sign-in ──────────────────────────────────────────────────────────────────

# Password for the public demo account (username: guest). Defaults to '123'.
GUEST_PASSWORD=
# Invite code for registration. SET — registration requires the code, which is what
# a club wants; EMPTY — anyone who opens the site can create an account.
REGISTRATION_CODE=

# Ordinary accounts (username + password) live in the store; they have no env vars.
# Admin rights are the isAdmin flag on the users:<id> record, set by hand in the store.

# ── Integrations ─────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# Where to send the browser back after OAuth. Unset — taken from the request headers.
APP_URL=

# Dish photos (Unsplash) — optional; without a key, dishes simply have no photo
UNSPLASH_ACCESS_KEY=

# Yandex Maps, for "when should I leave" questions — optional.
# Either set one YANDEX_MAPS_API_KEY, or the geocoder and router keys separately.
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_ROUTER_KEY=

# ── Optional settings ────────────────────────────────────────────────────────

PORT=3001
# Restrict which origin may call the API (in production, the site's Vercel URL).
# Empty = cross-origin requests are closed, which is what you want when the frontend
# and the API share a domain and have no need for them.
ALLOWED_ORIGIN=

# Spend guards for the AI (defaults: 60 / 300 / 1000 requests, 4000 characters)
AI_LIMIT_PER_MIN=
AI_LIMIT_PER_HOUR=
AI_LIMIT_PER_DAY=
AI_MAX_MESSAGE_CHARS=
# Daily AI request cap per device for demo guests and new accounts (defaults to 15)
AI_GUEST_DAILY_LIMIT=
# Log AI token spend to the server console
AI_DEBUG=
